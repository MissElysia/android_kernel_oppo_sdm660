-static bool oppo_chg_is_usb_present(void)
-{
-	int rc = 0;
-	u8 stat = 0;
-	bool vbus_rising = false;
-
-	if (!g_oppo_chip)
-		return false;
-
-	rc = smblib_read(&g_oppo_chip->pmic_spmi.smb2_chip->chg, USBIN_BASE + INT_RT_STS_OFFSET, &stat);
-	if (rc < 0) {
-		chg_err("Couldn't read USB_INT_RT_STS, rc=%d\n", rc);
-		return false;
-	}
-	vbus_rising = (bool)(stat & USBIN_PLUGIN_RT_STS_BIT);
-
-	if (vbus_rising == false && oppo_vooc_get_fastchg_started() == true) {
-		if (qpnp_get_prop_charger_voltage_now() > 2000) {
-			chg_err("USBIN_PLUGIN_RT_STS_BIT low but fastchg started true and chg vol > 2V\n");
-			vbus_rising = true;
-		}
-	}
-
-	if (vbus_rising == false)
-		g_oppo_chip->pmic_spmi.smb2_chip->chg.pre_current_ma = -1;
-
-	return vbus_rising;
-}
